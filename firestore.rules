rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'reese296@gmail.com';
    }

    // Signed in with a verified Google email that's on the member list (access/members)
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/access/members).data.byMember.values();
    }

    // The signed-in user is this member: their email is the one on the member list for that id
    function isSelf(memberId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/access/members).data.byMember.get(memberId, '') == request.auth.token.email.lower();
    }

    // Public trip and member data (live site: data, local dev: data-dev)
    match /app/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Member emails for guide access: admin only
    match /access/members {
      allow read, write: if isAdmin();
    }

    // Player's Guides, one per trip, members only (live site: guides, local dev: guides-dev)
    match /guides/{tripId} {
      allow read: if isAdmin() || isMember();
      allow write: if isAdmin();
    }
    match /guides-dev/{tripId} {
      allow read: if isAdmin() || isMember();
      allow write: if isAdmin();
    }

    // Draft teams, pairings, and handicaps: admin only (live site: guideDrafts, local dev: guideDrafts-dev)
    match /guideDrafts/{tripId} {
      allow read, write: if isAdmin();
    }
    match /guideDrafts-dev/{tripId} {
      allow read, write: if isAdmin();
    }

    // Fireball shots, one doc per player per trip: members see everyone's; each player changes
    // only their own (the admin can fix anyone's). Live site: fireball, local dev: fireball-dev.
    match /fireball/{tripId}/players/{memberId} {
      allow read: if isAdmin() || isMember();
      allow create, update: if (isAdmin() || isSelf(memberId))
        && request.resource.data.keys().hasOnly(['counts', 'updatedAt']);
    }
    match /fireball-dev/{tripId}/players/{memberId} {
      allow read: if isAdmin() || isMember();
      allow create, update: if (isAdmin() || isSelf(memberId))
        && request.resource.data.keys().hasOnly(['counts', 'updatedAt']);
    }

    // Player bios for the guide's profiles: members read, the admin writes.
    // Live site: profiles, local dev: profiles-dev.
    match /profiles/{playerId} {
      allow read: if isAdmin() || isMember();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['bio', 'updatedAt']);
    }
    match /profiles-dev/{playerId} {
      allow read: if isAdmin() || isMember();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['bio', 'updatedAt']);
    }
  }
}
